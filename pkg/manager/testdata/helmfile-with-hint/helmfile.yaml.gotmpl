releases:
  - name: mylocalrelease
    namespace: default
    chart: ../helmfile/mylocalchart
    version: 0.1.0
    values:
      - ../helmfile/mylocalchart/values.yaml
      - labelFromStatic: {{ .StateValues.labelFromStatic | default "default-label" }}
      - environment: {{ .StateValues.environment | default "unknown" }}
