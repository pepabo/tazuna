{
  "version": 4,
  "terraform_version": "1.9.8",
  "serial": 42,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "outputs": {
    "vpc_id": { "value": "vpc-0123456789abcdef0", "type": "string" },
    "account_id": { "value": 123456789012, "type": "number" },
    "ratio": { "value": 0.25, "type": "number" },
    "enabled": { "value": true, "type": "bool" },
    "private_subnet_ids": { "value": ["subnet-a", "subnet-b"], "type": ["list", "string"] },
    "cluster": {
      "value": { "name": "example", "endpoint": "https://example.invalid", "tags": { "env": "test" } },
      "type": ["object", { "name": "string", "endpoint": "string", "tags": ["map", "string"] }]
    },
    "db_password": { "value": "s3cr3t", "type": "string", "sensitive": true },
    "nothing": { "value": null, "type": "string" }
  },
  "resources": [
    {
      "mode": "managed",
      "type": "aws_vpc",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        { "schema_version": 1, "attributes": { "id": "vpc-0123456789abcdef0", "cidr_block": "10.0.0.0/16", "tags": { "Name": "main" } } }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_subnet",
      "name": "private",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        { "index_key": 0, "schema_version": 1, "attributes": { "id": "subnet-a" } },
        { "index_key": 1, "schema_version": 1, "attributes": { "id": "subnet-b" } }
      ]
    },
    {
      "mode": "data",
      "type": "aws_caller_identity",
      "name": "current",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        { "schema_version": 0, "attributes": { "account_id": "123456789012", "id": "123456789012" } }
      ]
    },
    {
      "module": "module.app[\"web\"]",
      "mode": "managed",
      "type": "aws_iam_role",
      "name": "this",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        { "index_key": "primary", "schema_version": 0, "attributes": { "arn": "arn:aws:iam::123456789012:role/web", "name": "web" } }
      ]
    },
    {
      "module": "module.network.module.subnets[0]",
      "mode": "managed",
      "type": "aws_route_table",
      "name": "rt",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        { "schema_version": 0, "attributes": { "id": "rtb-1" } }
      ]
    }
  ]
}
