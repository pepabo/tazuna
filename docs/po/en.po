#: src/reference/test-plugin.md:132 src/reference/test-plugin.md:144
#: src/reference/cli/init.md:25
msgid "apiVersion"
msgstr "apiVersion"

#: src/guides/first-tazuna-yaml.md:83 src/reference/test-plugin.md:101
#: src/reference/test-plugin.md:132
msgid "apps/v1"
msgstr "apps/v1"

#: src/guides/first-tazuna-yaml.md:83 src/guides/first-tazuna-yaml.md:125
#: src/guides/first-tazuna-yaml.md:144 src/reference/tazuna-yaml.md:22
#: src/reference/tazuna-hint-yaml.md:35 src/reference/genesis-secret.md:172
