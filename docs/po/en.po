msgstr "`hostname`"

#: src/reference/tazuna-hint-yaml.md:81
msgid ""
"RFC 952 / 1123 に準拠したホスト名パターン（英数字 / `-` / `.`、各ラベルは英数"
"字で開始・終了）"
msgstr ""
"RFC 952 / 1123 compliant hostname pattern (alphanumerics / `-` / `.`; each "
"label starts and ends with alphanumerics)"

#: src/reference/tazuna-hint-yaml.md:82
msgid "`url`"
msgstr "`url`"

#: src/reference/tazuna-hint-yaml.md:82
msgid "`net/url.ParseRequestURI` で解釈でき、かつ scheme が空でないこと"
msgstr ""
